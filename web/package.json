{
  "name": "virtmgr-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').writeFileSync('dist/.gitkeep','')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --workers=1",
    "e2e:serial": "playwright test --workers=1 && playwright test --workers=1 -c playwright.writable.config.ts"
  },

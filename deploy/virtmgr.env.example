# VirtMgr systemd environment
VIRTMGR_LISTEN=[::]:8443
VIRTMGR_LIBVIRT_URI=qemu:///system
VIRTMGR_DATABASE_PATH=/var/lib/virtmgr/virtmgr.db
VIRTMGR_HOST_NAME=x-cluster
VIRTMGR_ADMIN_USERNAME=admin
# Required only for the first start when the users table is empty.
VIRTMGR_ADMIN_PASSWORD=replace-with-a-strong-password
VIRTMGR_SESSION_TTL=8h
VIRTMGR_COOKIE_SECURE=false
# Only these reverse proxy IPs/CIDRs may supply X-Forwarded-For or X-Real-IP.
# Example: 127.0.0.1/32,10.0.0.0/8
VIRTMGR_TRUSTED_PROXIES=
# Optional native TLS. Set both paths to enable HTTPS, or leave both empty when
# TLS is terminated by nginx, Caddy or Cloudflare Tunnel. HTTPS responses include HSTS.
VIRTMGR_TLS_CERT_FILE=
VIRTMGR_TLS_KEY_FILE=
VIRTMGR_READ_ONLY=true
VIRTMGR_DEMO_MODE=false
